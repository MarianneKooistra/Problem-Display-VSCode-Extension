{
  "name": "problemdisplay",
  "displayName": "ProblemDisplay",
  "description": "A first extension to play with the possibilities. Goal is to make a little display of images that represent the amount of 'problems' that are in a project.",
  "version": "0.0.1",
  "publisher": "Marianne Kooistra",
  "repository": "https://github.com/MarianneKooistra/Problem-Display-VSCode-Extension",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [],
    "views": {
      "explorer": [
        {"id": "ProjectHealth", "name": "Project Health", "icon": "$(graph)"}
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
